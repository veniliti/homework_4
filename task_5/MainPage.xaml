<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Shop.MainPage">

    <VerticalStackLayout Padding="10" Spacing="10">

        <Grid ColumnDefinitions="*,*,*,*,*,2*,3*" BackgroundColor="LightGray">
            <Label Text="Type" FontAttributes="Bold" />
            <Label Text="Name" FontAttributes="Bold" Grid.Column="1" />
            <Label Text="Price" FontAttributes="Bold" Grid.Column="2" />
            <Label Text="Origin Country" FontAttributes="Bold" Grid.Column="3" />
            <Label Text="Package Date" FontAttributes="Bold" Grid.Column="4" />
            <Label Text="Description" FontAttributes="Bold" Grid.Column="5" />
            <Label Text="Details" FontAttributes="Bold" Grid.Column="6" />
        </Grid>

        <CollectionView x:Name="ItemsList" SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,*,*,*,*,2*,3*" Padding="0,5">
                        <Label Text="{Binding Type}" />
                        <Label Text="{Binding Name}" Grid.Column="1" />
                        <Label Text="{Binding Price}" Grid.Column="2" />
                        <Label Text="{Binding OriginCountry}" Grid.Column="3" />
                        <Label Text="{Binding PackageDate}" Grid.Column="4" />
                        <Label Text="{Binding Description}" Grid.Column="5" />
                        <Label Text="{Binding Details}" Grid.Column="6" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Spacing="10">
            <Button Text="Add Food" Clicked="OnAddFoodClicked" />
            <Button Text="Add Book" Clicked="OnAddBookClicked" />
            <Button Text="Remove" Clicked="OnRemoveItemClicked" />
        </HorizontalStackLayout>

    </VerticalStackLayout>

</ContentPage>